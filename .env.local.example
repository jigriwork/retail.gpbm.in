NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
ANALYTICS_QUERY_PATH=legacy

# MSG91 WhatsApp (server-only — real values belong in .env.local/Vercel, never in Git)
# Shared account key; the GP/BM keys are optional overrides for separate accounts.
MSG91_AUTH_KEY=
MSG91_GP_AUTH_KEY=
MSG91_BM_AUTH_KEY=
# Country code plus number, digits only (example: 919876543210).
MSG91_GP_INTEGRATED_NUMBER=
MSG91_BM_INTEGRATED_NUMBER=
# Exact approved MSG91 template names.
MSG91_GP_CUSTOMER_TEMPLATE=
MSG91_BM_CUSTOMER_TEMPLATE=
MSG91_GP_PAYSLIP_TEMPLATE=
MSG91_BM_PAYSLIP_TEMPLATE=
MSG91_GP_FOLLOWUP_TEMPLATE=
MSG91_BM_FOLLOWUP_TEMPLATE=
MSG91_TEMPLATE_LANGUAGE=en
MSG91_WEBHOOK_SECRET=
MSG91_MONTHLY_BUDGET_INR=1500
MSG91_BUDGET_BUFFER_INR=100
MSG91_SALARY_RESERVE_INR=25
MSG91_MONTHLY_FOLLOWUP_LIMIT=300
MSG91_DAILY_FOLLOWUP_LIMIT=10
MSG91_MARKETING_RATE_INR=0.8631
MSG91_UTILITY_RATE_INR=0.115
